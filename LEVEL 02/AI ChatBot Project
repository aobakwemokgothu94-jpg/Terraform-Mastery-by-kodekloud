💻 Code Reference (chatbot.py)
Python
import os
from openai import OpenAI

# Initialize the OpenAI client with environment credentials
client = OpenAI(
    api_key=os.environ.get('OPENAI_API_KEY'),
    base_url=os.environ.get('OPENAI_API_BASE')
)

# Define the conversational role and prompt
prompt = "You are a friendly travel guide. Greet the user and ask where they want to go."

# Request completion from the chat model
response = client.chat.completions.create(
    model="gpt-5.6-luna",
    messages=[
        {"role": "user", "content": prompt}
    ],
    temperature=0.7,
    max_tokens=100
)

# Extract and output the generated response
reply = response.choices[0].message.content
print(reply)
