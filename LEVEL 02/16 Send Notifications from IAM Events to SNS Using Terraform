Full Configuration Files
main.tf
Terraform
# 1. Create SNS Topic
resource "aws_sns_topic" "devops_sns" {
  name = "devops-sns-topic"
}

# 2. Create IAM Role with EC2 as the trusted entity
data "aws_iam_policy_document" "ec2_assume_role" {
  statement {
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["ec2.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "devops_role" {
  name               = "devops-sns-role"
  assume_role_policy = data.aws_iam_policy_document.ec2_assume_role.json
}

# 3. Create IAM Policy that grants permission to publish messages to the SNS topic
data "aws_iam_policy_document" "sns_publish" {
  statement {
    actions   = ["sns:Publish"]
    resources = [aws_sns_topic.devops_sns.arn]
  }
}

resource "aws_iam_policy" "devops_policy" {
  name   = "devops-sns-policy"
  policy = data.aws_iam_policy_document.sns_publish.json
}

# Attach Policy to Role
resource "aws_iam_role_policy_attachment" "attach" {
  role       = aws_iam_role.devops_role.name
  policy_arn = aws_iam_policy.devops_policy.arn
}
locals.tf
Terraform
locals {
  KKE_SNS_TOPIC_NAME = aws_sns_topic.devops_sns.name
  KKE_ROLE_NAME      = aws_iam_role.devops_role.name
  KKE_POLICY_NAME    = aws_iam_policy.devops_policy.name
}
outputs.tf
Terraform
output "kke_sns_topic_name" {
  value = local.KKE_SNS_TOPIC_NAME
}

output "kke_role_name" {
  value = local.KKE_ROLE_NAME
}

output "kke_policy_name" {
  value = local.KKE_POLICY_NAME
}
