Task 2 (t2q1): AWS KMS Symmetric Key & File Encryption/DecryptionArchitecture & ImplementationKey Management: Provisions a symmetric Customer Master Key (SYMMETRIC_DEFAULT) with automatic key rotation enabled and alias alias/datacenter-kms-key-t2q1.Encryption & Artifact Persistence: Encrypts SensitiveData.txt using aws_kms_ciphertext and writes the base64-encoded ciphertext blob to EncryptedData.bin via local_file.Decryption Verification: Reads EncryptedData.bin back through data.aws_kms_secrets and validates round-trip decryption against the original plaintext.HCL Configuration (t2q1)main.tfTerraformresource "aws_kms_key" "kke_kms_key" {
  description             = "Symmetric KMS key datacenter-kms-key-t2q1"
  deletion_window_in_days = 7
  enable_key_rotation     = true

  tags = {
    Name = "datacenter-kms-key-t2q1"
  }
}

resource "aws_kms_alias" "kke_kms_alias" {
  name          = "alias/datacenter-kms-key-t2q1"
  target_key_id = aws_kms_key.kke_kms_key.key_id
}

resource "aws_kms_ciphertext" "encrypted_sensitive_data" {
  key_id    = aws_kms_key.kke_kms_key.key_id
  plaintext = file("${path.module}/SensitiveData.txt")
}

resource "local_file" "encrypted_data_bin" {
  content  = aws_kms_ciphertext.encrypted_sensitive_data.ciphertext_blob
  filename = "${path.module}/EncryptedData.bin"
}

data "aws_kms_secrets" "decrypted_sensitive_data" {
  depends_on = [local_file.encrypted_data_bin]

  secret {
    name    = "sensitive_data"
    payload = file("${path.module}/EncryptedData.bin")
  }
}
outputs.tfTerraformoutput "kke_kms_key_name" {
  description = "Name of the KMS key created"
  value       = replace(aws_kms_alias.kke_kms_alias.name, "alias/", "")
}
