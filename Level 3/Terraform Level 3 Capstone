Task 3 (t3q3): Multi-Workspace API Gateway & CloudWatch ProvisioningArchitecture & ImplementationWorkspace State Isolation: Uses terraform workspace (dev and prod) to maintain separate state files and dynamically prefix resource names with ${terraform.workspace}.Iterative Provisioning: Uses count = length(var.KKE_API_NAMES) and splat expressions ([*]) to provision paired REST APIs and CloudWatch Log Groups across environments.Provisioner Audit Trail: Executes local-exec provisioners upon resource creation to log workspace-scoped confirmation messages to apigateway.log and loggroups.log.HCL Configuration (t3q3)variables.tfTerraformvariable "KKE_API_NAMES" {
  description = "List of API Gateway base names to create per workspace"
  type        = list(string)
}
terraform.tfvarsTerraformKKE_API_NAMES = [
  "datacenter-api-1",
  "datacenter-api-2"
]
main.tfTerraformlocals {
  api_names       = [for api in var.KKE_API_NAMES : "${terraform.workspace}-${api}"]
  log_group_names = [for api in local.api_names : "/aws/apigateway/${api}"]
}

resource "aws_api_gateway_rest_api" "kke_api" {
  count = length(var.KKE_API_NAMES)
  name  = local.api_names[count.index]

  provisioner "local-exec" {
    command = "echo 'Created API Gateway ${self.name} in workspace ${terraform.workspace}' >> /home/bob/terraform/t3q3/apigateway.log"
  }
}

resource "aws_cloudwatch_log_group" "kke_api_logs" {
  count = length(var.KKE_API_NAMES)
  name  = local.log_group_names[count.index]

  provisioner "local-exec" {
    command = "echo 'Created Log Group ${self.name} in workspace ${terraform.workspace}' >> /home/bob/terraform/t3q3/loggroups.log"
  }
}
outputs.tfTerraformoutput "kke_api_gateway_names" {
  description = "List of API Gateway names created in the active workspace"
  value       = aws_api_gateway_rest_api.kke_api[*].name
}

output "kke_log_group_names" {
  description = "List of CloudWatch Log Group names created in the active workspace"
  value       = aws_cloudwatch_log_group.kke_api_logs[*].name
}
