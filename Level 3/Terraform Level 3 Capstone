Task 1 (t1q2): IAM Naming Sanitization & Tagging GovernanceArchitecture & ImplementationInput Validation: Enforces non-empty project identifiers and restricts team names to alphanumeric characters, hyphens, and underscores (^[A-Za-z0-9_-]+$).String Sanitization (locals): Normalizes inputs to lowercase, replaces consecutive non-alphanumeric sequences with single hyphens (replace(..., "/[^a-z0-9]+/", "-")), and strips leading or trailing hyphens via trim(..., "-").Tagging Governance: Merges a standardized common_tags map (Project, Team, ManagedBy, Env) with role-specific attributes (RoleType = "EC2").HCL Configuration (t1q2)variables.tfTerraformvariable "KKE_PROJECT" {
  description = "Name of the project"
  type        = string

  validation {
    condition     = length(trimspace(var.KKE_PROJECT)) > 0
    error_message = "KKE_PROJECT must be non-empty."
  }
}

variable "KKE_TEAM" {
  description = "Name of the team"
  type        = string

  validation {
    condition     = can(regex("^[A-Za-z0-9_-]+$", var.KKE_TEAM))
    error_message = "KKE_TEAM must contain only letters, digits, dashes, or underscores."
  }
}

variable "KKE_ENVIRONMENT" {
  description = "Name of the environment"
  type        = string
}
terraform.tfvarsTerraformKKE_PROJECT     = "datacenter-t1q2"
KKE_TEAM        = "dev-team"
KKE_ENVIRONMENT = "dev"
main.tfTerraformlocals {
  sanitized_project = trim(replace(lower(var.KKE_PROJECT), "/[^a-z0-9]+/", "-"), "-")
  sanitized_team    = trim(replace(lower(var.KKE_TEAM), "/[^a-z0-9]+/", "-"), "-")
  name_prefix       = "${local.sanitized_project}-${local.sanitized_team}"

  common_tags = {
    Project   = var.KKE_PROJECT
    Team      = var.KKE_TEAM
    ManagedBy = "Terraform"
    Env       = var.KKE_ENVIRONMENT
  }
}

resource "aws_iam_user" "kke_user" {
  name = "${local.name_prefix}-user"
  tags = local.common_tags
}

resource "aws_iam_role" "kke_role" {
  name = "${local.name_prefix}-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "ec2.amazonaws.com"
        }
      }
    ]
  })

  tags = merge(
    local.common_tags,
    {
      RoleType = "EC2"
    }
  )
}
outputs.tfTerraformoutput "kke_user_name" {
  description = "The name of the created IAM User"
  value       = aws_iam_user.kke_user.name
}

output "kke_role_name" {
  description = "The name of the created IAM Role"
  value       = aws_iam_role.kke_role.name
}

output "kke_tags_applied" {
  description = "The tags applied to the IAM User"
  value       = aws_iam_user.kke_user.tags
}
